# =====================================================================
# Frontend (Vite + React + TypeScript + Tailwind) .gitignore
# =====================================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Lockfiles from other package managers (keep package-lock.json) -----
yarn.lock
pnpm-lock.yaml

# ----- Build output -----
dist/
dist-ssr/
build/
out/
.vite/
.cache/
.parcel-cache/

# ----- Environment / secrets -----
.env
.env.*
!.env.example

# ----- Logs -----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Editor / IDE -----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- OS files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----- Tooling caches -----
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# ----- Local notes / scratch -----
.local/
.tmp/
tmp/
*.local

# ----- Misc -----
*.pem
.history/
